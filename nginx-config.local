# HTTPS server block
server {
    listen 443 ssl;
    server_name 67.213.113.23;

    # Self-signed SSL certificates
    ssl_certificate /etc/ssl/certs/alphastats-selfsigned.crt;
    ssl_certificate_key /etc/ssl/private/alphastats-selfsigned.key;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # WebSocket endpoints — regex matches any /api/v1/.../ws path so new WS
    # endpoints (e.g. /api/v1/subnets/{netuid}/ws) work without further changes.
    # MUST appear before the general location / block.
    location ~ ^/api/v1/.+/ws$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket upgrade headers - CRITICAL!
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-lived connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;

        # Disable buffering for WebSocket
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# HTTP server block - redirect to HTTPS
server {
    listen 80;
    server_name 67.213.113.23;
    
    # Redirect all HTTP traffic to HTTPS
    return 301 https://$server_name$request_uri;
}