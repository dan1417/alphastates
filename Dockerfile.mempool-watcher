FROM python:3.10-slim

WORKDIR /app

# Install system deps for substrate-interface if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-mempool.txt .
RUN pip install --no-cache-dir -r requirements-mempool.txt

COPY src/ ./src/

CMD ["python", "-m", "src.mempool_watcher.main"]
