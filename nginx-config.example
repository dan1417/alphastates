server {
    server_name alphastats.io www.alphastats.io;

    # WebSocket endpoints — regex matches any /api/v1/.../ws path so new WS
    # endpoints (e.g. /api/v1/subnets/{netuid}/ws) work without further changes.
    # MUST appear before the general location / block.
    location ~ ^/api/v1/.+/ws$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket upgrade headers - CRITICAL!
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for long-lived connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 60s;

        # Disable buffering for WebSocket
        proxy_buffering off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/alphastats.io/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/alphastats.io/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.alphastats.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = alphastats.io) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name alphastats.io www.alphastats.io;
    return 404; # managed by Certbot




}